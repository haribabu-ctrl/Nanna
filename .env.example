# ============================================================
# PRIVATE LOVE VAULT — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Your project's public URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon key (safe to expose — protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service-role key — SERVER ONLY. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Session / JWT ─────────────────────────────────────────────
# 32+ character random secret for signing vault session cookies
VAULT_SESSION_SECRET=replace_with_64_random_hex_chars_minimum_32_bytes

# Cookie name for the vault session
VAULT_SESSION_COOKIE=plv_session

# Session max-age in seconds (default 24 hours)
SESSION_MAX_AGE=86400

# ── Auth Credentials (server-side only) ──────────────────────
# 6-digit PIN — stored as bcrypt hash in DB, set during setup
# VAULT_PIN_HASH is populated by the /api/setup endpoint.
# Do NOT set raw PIN here.

# Secret name / passphrase — stored as bcrypt hash in DB
# VAULT_SECRET_NAME_HASH is populated by /api/setup

# 4-digit code — stored as bcrypt hash in DB
# VAULT_CODE_HASH is populated by /api/setup

# ── Owner Setup & Recovery ────────────────────────────────────
# One-time master token required to unlock the /setup page
VAULT_SETUP_TOKEN=your_secure_master_setup_token_here

# Set to "true" after first successful setup to disable public enrollment
SETUP_COMPLETED=false

# ── Supabase Storage Bucket ───────────────────────────────────
# Name of the PRIVATE bucket in Supabase Storage
STORAGE_BUCKET=vault-media

# ── App & CORS Config ────────────────────────────────────────
# Primary deployed app URL (Render Web Service domain)
NEXT_PUBLIC_APP_URL=https://your-app-name.onrender.com

# Optional CORS allowed origin (set if frontend and backend domains differ)
FRONTEND_URL=https://your-frontend-name.onrender.com

NODE_ENV=production

